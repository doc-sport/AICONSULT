# Clé API Anthropic (obligatoire, sauf en mode démonstration)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle Claude utilisé pour la rédaction du compte rendu
CLAUDE_MODEL=claude-opus-5
# Niveau d'effort de raisonnement : low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# Adresse et port d'écoute. Par défaut, uniquement accessible depuis cet ordinateur.
HOST=127.0.0.1
PORT=3000

# Mode démonstration : renvoie un compte rendu fictif sans appeler Claude (1 pour activer)
AICONSULT_MOCK=0

# Transcription côté serveur (optionnelle). Point d'accès compatible avec l'API
# « audio/transcriptions » (Whisper). Exemples :
#   https://api.openai.com/v1/audio/transcriptions   (service OpenAI)
#   http://localhost:8000/v1/audio/transcriptions     (serveur Whisper local, ex. faster-whisper-server)
# Sans ces variables, l'application utilise la reconnaissance vocale du navigateur.
#TRANSCRIPTION_API_URL=
#TRANSCRIPTION_API_KEY=
#TRANSCRIPTION_MODEL=whisper-1
